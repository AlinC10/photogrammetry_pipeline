R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=photogrammetry-pipeline
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Debug data of the scans (tools/pull_debug.py): its own bucket, never R2_BUCKET; optional token for it only
R2_DEBUG_BUCKET=photogrammetry-debug
R2_DEBUG_ACCESS_KEY_ID=
R2_DEBUG_SECRET_ACCESS_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_API_TOKEN=

RUNPOD_API_KEY=
TURNTABLE_IMAGE=
RUNPOD_REGISTRY_AUTH_ID=
RUNPOD_GPU_TYPES=
# Default GPU list: fastest first, only those up to this price ($/h, Secure Cloud); 1.20 adds the RTX 5090
RUNPOD_MAX_GPU_PRICE=1.10
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_POD_MAX_RUNTIME_S=3600
RUNPOD_BOOT_TIMEOUT_S=600
# Asked for first, then lowered to the job's minimum when no host has them (0 = only the minimum)
RUNPOD_PREFERRED_VCPU=16
RUNPOD_PREFERRED_RAM_GB=48
