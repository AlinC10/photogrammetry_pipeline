# Copiază în .env (ignorat de git și de Docker) și completează. Folosit de tools/cloud_test_run.py și de Pi.

# --- Cloudflare R2 (bucket-ul scanerului) ---
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=photogrammetry-pipeline
# Cheie R2 S3 limitată la bucket (Object Read & Write). Rămâne pe Pi/laptop; e și "parent" pentru cheile temporare.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Cloudflare API: doar pentru credențialele temporare ale pod-ului (TTL = RUNPOD_POD_MAX_RUNTIME_S) ---
CLOUDFLARE_ACCOUNT_ID=
# Token API cu permisiune doar pe R2 (nu "tot contul"). Nu pleacă niciodată spre pod.
CLOUDFLARE_R2_API_TOKEN=

# --- RunPod ---
RUNPOD_API_KEY=
# Imaginea urcată în registry (ex. ghcr.io/<user>/turntable-studio:v1)
TURNTABLE_IMAGE=
# Pentru imagine privată: ID-ul credențialelor de registry din contul RunPod (Settings > Container Registry Auth)
RUNPOD_REGISTRY_AUTH_ID=
# Plăci acceptate, în ordinea preferată (ieftine întâi); goală = lista implicită din cloud/runpod.py
RUNPOD_GPU_TYPES=
# SECURE sau COMMUNITY
RUNPOD_CLOUD_TYPE=SECURE
# Plafonul de timp al pod-ului, în secunde; cheile R2 ale pod-ului expiră după același timp
RUNPOD_POD_MAX_RUNTIME_S=3600
